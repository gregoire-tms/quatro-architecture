{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "760px",
            "wideSize": "1440px"
        },
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "slug": "black",
                    "name": "Encre",
                    "color": "#141414"
                },
                {
                    "slug": "white",
                    "name": "Blanc",
                    "color": "#ffffff"
                },
                {
                    "slug": "grey",
                    "name": "Gris",
                    "color": "#6b6b6b"
                },
                {
                    "slug": "light-grey",
                    "name": "Pierre",
                    "color": "#f2f2ef"
                },
                {
                    "slug": "lime",
                    "name": "Vert QuAtro",
                    "color": "#cbd401"
                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "units": [
                "px",
                "rem",
                "%",
                "vw"
            ]
        },
        "typography": {
            "fluid": true,
            "customFontSize": false,
            "fontFamilies": [
                {
                    "slug": "sans",
                    "name": "Hanken Grotesk",
                    "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Hanken Grotesk",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/hanken-grotesk-latin-wght.woff2"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Petit",
                    "size": "0.875rem"
                },
                {
                    "slug": "normal",
                    "name": "Normal",
                    "size": "1.0625rem"
                },
                {
                    "slug": "large",
                    "name": "Grand",
                    "size": "1.75rem"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--white)",
            "text": "var(--wp--preset--color--black)"
        },
        "spacing": {
            "blockGap": "1.5rem"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "fontSize": "var(--wp--preset--font-size--normal)",
            "fontWeight": "400",
            "lineHeight": "1.65"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontWeight": "300",
                    "lineHeight": "1.1"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--black)"
                },
                "typography": {
                    "textDecoration": "none"
                }
            }
        }
    }
}
